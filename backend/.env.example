# Copiar a .env y completar.

# En Render se usa la "Internal Database URL" de la base administrada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestor_vehiculos

# Mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_EXPIRE_MINUTES=60

# URL exacta del frontend. Varias separadas por coma.
CORS_ORIGINS=http://localhost:5173
